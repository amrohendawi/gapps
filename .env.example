# Gapps MCP Server Authentication Configuration
# Copy this file to .env and set your actual credentials

API_BASE_URL="http://localhost:8000/api/v1"

LOCALAI_API_URL="http://192.168.0.128:1234/v1"
OPENAI_API_KEY="sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"

# API Authentication Token (REQUIRED)
# Get token via: curl -X POST http://localhost:8000/login -H "Content-Type: application/json" -d '{"email":"admin@example.com","password":"your_password"}'
GAPPS_API_TOKEN=your-api-token-here

# Database Configuration (existing)
POSTGRES_USER=db1
POSTGRES_PASSWORD=db1
POSTGRES_DB=db1
POSTGRES_HOST=postgres
RESET_DB=no
VERSION=1.0.0
